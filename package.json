{
  "name": "jobtrending",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local job collection, configurable matching, application queue and AI-assisted recruiting conversations",
  "scripts": {
    "login": "node ./src/cli/login.mjs",
    "import-cookies": "node ./src/cli/import-cookies.mjs",
    "collect-cookies": "node ./src/cli/collect-cookies.mjs",
    "crawl": "node ./src/cli/crawl.mjs",
    "enrich": "node ./src/cli/enrich.mjs",
    "all": "node ./src/cli/run.mjs",
    "web": "node ./src/cli/server.mjs",
    "check": "node ./src/cli/check.mjs",
    "test:recruiting": "node --test ./tests/recruiting.test.mjs",
    "research:boss": "node ./scripts/export-boss-robotics-evidence.mjs",
    "research:report": "node ./scripts/build-robotics-market-report.mjs",
    "research:audit": "node ./scripts/audit-robotics-skills.mjs",
    "setup": "node ./scripts/setup.mjs",
    "postinstall": "node ./scripts/setup.mjs",
    "test": "node --test",
    "start": "node ./src/cli/server.mjs",
    "research:candidates": "node ./scripts/export-robotics-review-candidates.mjs",
    "research:prepare": "node ./scripts/prepare-robotics-review.mjs",
    "research:validate": "node ./scripts/validate-verdicts.mjs ./data/research/robotics-review-candidates.json ./data/research/robotics-review-draft.json",
    "research:export": "node ./scripts/export-reviewed-robotics-evidence.mjs",
    "report:pdf": "node ./scripts/make-pdf.mjs"
  },
  "dependencies": {
    "@geekgeekrun/puppeteer-extra-plugin-laodeng": "^0.0.1",
    "better-sqlite3": "^11.8.1",
    "dayjs": "^1.11.13",
    "express": "^4.21.2",
    "nunjucks": "^3.2.4",
    "playwright": "^1.52.0",
    "puppeteer": "^24.19.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-anonymize-ua": "^2.4.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "yargs": "^17.7.2",
    "zod": "^3.24.2"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0"
  },
  "overrides": {
    "qs": "^6.16.1"
  }
}
